{
  "name": "@sqraft/desktop",
  "version": "0.0.5",
  "private": true,
  "description": "Sqraft 桌面应用",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wfdx165/sqraft.git",
    "directory": "apps/desktop"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "clean": "node scripts/clean.mjs",
    "dist": "pnpm clean && pnpm build && node scripts/dist.mjs",
    "dist:dir": "pnpm clean && pnpm build && node scripts/dist.mjs --dir",
    "verify:pack": "node scripts/verify-pack.mjs",
    "release": "node scripts/release.mjs",
    "publish:release": "node scripts/release.mjs --publish-draft",
    "check:readmes": "node scripts/check-readmes.mjs",
    "stage:update": "node scripts/stage-update.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@sqraft/ai-tools": "workspace:*",
    "@sqraft/core": "workspace:*",
    "@sqraft/render": "workspace:*",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "5.2.4",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "fflate": "0.8.3",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "2.1.9",
    "vue": "3.5.44"
  }
}
